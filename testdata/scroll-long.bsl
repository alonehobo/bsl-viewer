#Область ПрограммныйИнтерфейс

// Возвращает представление контрагента для печатной формы.
//
// Параметры:
//   Контрагент - СправочникСсылка.Контрагенты - ссылка на контрагента.
//
// Возвращаемое значение:
//   Строка - представление вида "ИНН 1234567890, ООО Ромашка".
//
Функция ПредставлениеКонтрагента(Контрагент) Экспорт

	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Возврат "";
	КонецЕсли;

	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Контрагент, "ИНН,Наименование");

	Представление = "";
	Если ЗначениеЗаполнено(Реквизиты.ИНН) Тогда
		Представление = "ИНН " + Реквизиты.ИНН + ", ";
	КонецЕсли;

	Возврат Представление + Реквизиты.Наименование;

КонецФункции

Процедура ЗаписатьЖурнал(Знач Текст, Знач Уровень = Неопределено) Экспорт

	Попытка
		ЗаписьЖурналаРегистрации("Пример.Отладка", Уровень, , , Текст);
	Исключение
		// Журнал недоступен — молча игнорируем.
	КонецПопытки;

