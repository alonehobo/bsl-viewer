{
  "name": "1c-preview-core",
  "version": "0.1.0",
  "private": true,
  "description": "Shared 1C preview renderers, provider registry and document helpers used by the Total Commander viewer, the MCP server and the VS Code extension",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./manifest.mjs",
    "./manifest.mjs": "./manifest.mjs",
    "./assets.manifest.json": "./assets.manifest.json",
    "./node/document.cjs": "./node/document.cjs",
    "./browser/*": "./browser/*"
  },
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "verify": "node scripts/verify.mjs",
    "test": "node --test tests/*.test.mjs"
  }
}
