{
  "name": "1c-form-viewer-vscode",
  "displayName": "1C Form Viewer",
  "description": "Visual preview of 1C managed forms, spreadsheet templates and MXL files in VS Code",
  "version": "0.2.0",
  "publisher": "alonehobo",
  "author": {
    "name": "Sergey Martemyanov",
    "email": "sergey.martemyanov@gmail.com",
    "url": "https://github.com/alonehobo"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alonehobo/bsl-viewer.git",
    "directory": "packages/1c-form-viewer-vscode"
  },
  "homepage": "https://github.com/alonehobo/bsl-viewer/tree/main/packages/1c-form-viewer-vscode",
  "license": "MIT",
  "engines": {
    "vscode": "^1.101.0"
  },
  "os": [
    "win32"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:1cFormViewer.openPreview"
  ],
  "main": "extension.js",
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "1cFormViewer.mcp",
        "label": "1C Form Viewer"
      }
    ],
    "configuration": {
      "title": "1C Form Viewer",
      "properties": {
        "1cFormViewer.mcp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Register the bundled 1C Form Viewer MCP server in VS Code Chat."
        },
        "1cFormViewer.mcp.allowAnyPath": {
          "type": "boolean",
          "default": false,
          "description": "Allow the MCP server to read supported files outside the current workspace folders."
        },
        "1cFormViewer.mcp.additionalRoots": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Additional absolute directories that the MCP server may read when allowAnyPath is disabled."
        }
      }
    },
    "commands": [
      {
        "command": "1cFormViewer.openPreview",
        "title": "1C: Open Visual Preview",
        "icon": "$(preview)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "1cFormViewer.openPreview",
          "when": "true"
        }
      ],
      "explorer/context": [
        {
          "command": "1cFormViewer.openPreview",
          "when": "resourceExtname == .xml || resourceExtname == .mxl",
          "group": "navigation@80"
        }
      ],
      "editor/context": [
        {
          "command": "1cFormViewer.openPreview",
          "when": "resourceExtname == .xml || resourceExtname == .mxl",
          "group": "navigation@80"
        }
      ],
      "editor/title": [
        {
          "command": "1cFormViewer.openPreview",
          "when": "resourceFilename =~ /\\.(xml|mxl)$/i",
          "group": "navigation@1"
        }
      ]
    }
  },
  "scripts": {
    "sync": "node ../1c-preview-core/scripts/sync.mjs",
    "build": "npm run sync && node scripts/copy-assets.mjs && powershell -NoProfile -ExecutionPolicy Bypass -File ../1c-form-viewer/scripts/build-native.ps1 -Output ./mcp",
    "verify:assets": "node ../1c-preview-core/scripts/verify.mjs",
    "vscode:prepublish": "npm run build",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "1c-preview-core": "*"
  }
}
